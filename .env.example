# Existing managed form service. This is a public form ID, designed for browser use.
# When present, the form uses Web3Forms directly; do not put private API keys here.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Optional alternative: server-side Resend delivery and persistent Redis limits.
# Server-only settings. Do not prefix these names with NEXT_PUBLIC_.
# Obtain a verified sender and API key from Resend; configure a writable Upstash Redis.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=vibhrav@gmail.com
CONTACT_ALLOWED_ORIGINS=http://127.0.0.1:4310,http://localhost:4310,https://vibhrav.vercel.app
CONTACT_FORM_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
